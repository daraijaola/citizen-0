# CITIZEN-0 runtime
CITIZEN_MODE=mock
# mock | live

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Prefer your own Helius/QuickNode key in production

# Agent worker wallet (JSON array path from solana-keygen) — LIVE only
AGENT_WALLET_PATH=
# Policy signer wallet (separate key; never same as agent spend hot path)
POLICY_SIGNER_WALLET_PATH=

# AgenC
AGENC_RPC_URL=https://api.mainnet-beta.solana.com
AGENC_CAPABILITIES=1

# Tax / plot (mock defaults match Energy City whitepaper)
PLOT_ID=CITIZEN-0-PLOT-001
PLOT_SIZE=10
MONTHLY_TAX_USD=0.22
TAX_DUE_IN_DAYS=6
STARTING_BALANCE_SOL=0.05

# Telegram (Phase 3) — optional; without these, diary still writes file+console
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIARY_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Set to 1 to wait for APPROVE/DENY on spend intents (timeout auto-approves)
TELEGRAM_ADMIN_GATE=0
TELEGRAM_ADMIN_TIMEOUT_MS=45000

# LLM workers (Phase 2)
OPENAI_API_KEY=

# Persistence
DATA_DIR=./data
