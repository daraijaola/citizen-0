# CITIZEN-0 demo scenario — fixed inputs so the arc replays identically.
#
# This is the SIMULATED track: a seeded local marketplace that always has
# claimable work, so the full economic story is observable end to end.
# The LIVE track (mainnet) runs separately on the public record.
#
# Tuning note: tax is ~0.00133 SOL, and coverage = balance / tax.
# The firm gate is coverage >= 3 (~0.004 SOL) and society is >= 4 (~0.0053 SOL).
# Starting at 0.03 SOL put coverage at ~22, so the agent unlocked the firm and
# spawned its society on tick 1 and there was no visible progression.
# But registering with the marketplace costs a 0.01 SOL stake, so anything below
# that and the agent cannot even enter the economy (it dies staking).
# 0.0135 SOL leaves ~0.0035 after the stake -> coverage ~2.6, just under the
# firm gate, so CITIZEN-0 has to earn its way across both gates while you watch.

CITIZEN_MODE=mock
DATA_DIR=/data

STARTING_BALANCE_SOL=0.0135
TAX_DUE_IN_DAYS=6
PLOT_SIZE=10
PLOT_ID=CITIZEN-0-PLOT-001

# Seeded jobs are exhausted by tick 7, so stop there: every later tick is an
# idle no_eligible_job and adds nothing to the demo.
MAX_TICKS=8
FAST_TICKS=1

# No mainnet, no wallet, no signing in the demo container.
LIVE_MUTATIONS=0

# Telegram intentionally DISABLED. The demo must never post into the real
# public diary channel — that record is part of the live audit trail.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIARY_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_GATE=0
